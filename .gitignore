# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# unused/generated files
contrast-test-results.json

# local
android-tv/local.properties

# Android / Gradle 构建产物
# 注意: 上面的 /build 只匹配根目录, android-tv/app/build 需要单独规则。
android-tv/app/build/
android-tv/build/
android-tv/.gradle/
android-tv/.kotlin/
android-tv/captures/
*.apk
*.aab
*.ap_
*.dex
