<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端诊断层: WebView 加载失败时显示, 避免白屏无信息 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/error_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F50D0F14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_title"
        android:textColor="#FF6B7280"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/error_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#FF16181F"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="#F5B942"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/error_retry_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="@string/error_retry"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/error_wall_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="@string/error_wall"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <Button
            android:id="@+id/error_settings_button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:text="@string/error_settings"
            android:textAllCaps="false"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/error_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/error_hint"
        android:textColor="#9EA7BA"
        android:textSize="15sp" />
</LinearLayout>
